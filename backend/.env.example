# PEIS (Personal Engineering Intelligence System) Environment Configuration Example
# Copy this file to '.env' in the backend directory:
#   copy .env.example .env

# Active LLM Provider for Chat & Code Reasoning: "local" (Ollama)
# Chat, search, and memory run 100% locally on your machine.
ACTIVE_LLM_PROVIDER=local

# Local Ollama Service Host & Model Configurations
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Cloud AI Keys (Required ONLY for dynamic Mermaid Diagram Generation)
# Leave blank if you prefer AST-driven local diagram fallbacks. Only 1 key is required.
GEMINI_API_KEY=
GROQ_API_KEY=

# Backend System Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
